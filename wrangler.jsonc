// Deployed with `npx wrangler deploy` from a machine logged into the hosting account (check `wrangler whoami`).
// Only ./site is served. Tooling, sources and data never are.
{
  "name": "european-dental",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // the workers.dev preview stays on until launch, when this turns false
  "workers_dev": true,
  "routes": [
    { "pattern": "dentaleuropean.com", "custom_domain": true },
    { "pattern": "www.dentaleuropean.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
