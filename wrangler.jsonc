// Deployed with `npx wrangler deploy` from a machine logged into the hosting account (check `wrangler whoami`).
// Only ./site is served. Tooling, sources and data never are.
{
  "name": "european-dental",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
